{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Elasticsearch",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Flowist.ApiGateway",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "flowist-apigateway-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv8",
          "numberOfShards": 1,
          "numberOfReplicas": 0
        }
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "workspaces-route": {
        "ClusterId": "task-cluster",
        "Match": {
          "Path": "/api/workspaces/{**catch-all}"
        }
      },
      "projects-route": {
        "ClusterId": "task-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "tasks-route": {
        "ClusterId": "task-cluster",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "activity-workspace-root-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/workspaces/{workspaceId}/activities"
        }
      },
      "activity-workspace-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/workspaces/{workspaceId}/activities/{**catch-all}"
        }
      },
      "activity-route": {
        "ClusterId": "activity-cluster",
        "Match": {
          "Path": "/api/activities/{**catch-all}"
        }
      },
      "notification-hub-root-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/notification"
        }
      },
      "notification-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5123/"
          }
        }
      },
      "task-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "task-service": {
            "Address": "http://localhost:5147/"
          }
        }
      },
      "notification-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "notification-service": {
            "Address": "http://localhost:5233/"
          }
        }
      },
      "activity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "activity-service": {
            "Address": "http://localhost:5038/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
